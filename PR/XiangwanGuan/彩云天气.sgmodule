#!name=彩云天气
#!desc=2026-10-10 09:37:55

[Rule]
DOMAIN,ad.cyapi.cn,REJECT,pre-matching
DOMAIN,gather.colorfulclouds.net,REJECT,pre-matching

[Body Rewrite]
http-response-jq ^https?:\/\/starplucker\.cyapi\.cn\/v\d+\/config 'if (.|type)=="object" then ((if (.pic_page_card_orders|type)=="array" then .pic_page_card_orders |= map(select(((.name|type)=="string" and (.name|test("^(A|C01)"))) | not)) else . end) | (if (.map_page_card_orders|type)=="array" then .map_page_card_orders |= map(select(((.name|type)=="string" and (.name|test("^(A|C01)"))) | not)) else . end)) else . end'
http-response-jq ^https?:\/\/starplucker\.cyapi\.cn\/v\d+\/config 'if type=="object" then del(.search_suggestions) else . end'
http-response-jq ^https?:\/\/starplucker\.cyapi\.cn\/v\d+\/config\/cypage\/\w+\/conditions 'if (.|type)=="object" then (.popups = [] | .actions = [] | if (.results|type)=="array" then .results |= map(.popups = [] | .actions = []) else . end) else . end'
http-response-jq ^https?:\/\/wrapper\.cyapi\.cn\/v\d+\/activity\?.*type_id=(?:A08|F04) 'if (.activities|type)=="array" then .activities = [] else . end'
http-response-jq ^https?:\/\/wrapper\.cyapi\.cn\/v\d+\/activity\?.*type_id=A03 'if (.|type)=="object" and (.activities|type)=="array" then (.activities[] |= (if .feature != null then .feature = false else . end)) else . end'
http-response-jq ^https?:\/\/wrapper\.cyapi\.cn\/v\d+\/activity\?.*type_id=C01 'if (.activities|type)=="array" then (.activities |= map(select((.name | IN("guide_svip","invite_svip")) | not))) else . end'

[MITM]
hostname = %APPEND% starplucker.cyapi.cn,wrapper.cyapi.cn
