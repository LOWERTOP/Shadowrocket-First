#!name=小红书
#!desc=2026-10-08 16:12:12

[Rule]
DOMAIN,apm-fe.xiaohongshu.com,REJECT,pre-matching
DOMAIN,apm-native.xiaohongshu.com,REJECT,pre-matching
DOMAIN,spider-tracker.xiaohongshu.com,REJECT,pre-matching
DOMAIN,t3.xiaohongshu.com,REJECT,pre-matching
DOMAIN-SUFFIX,miaozhen.com,REJECT,pre-matching
DOMAIN-WILDCARD,ads-*.xhscdn.com,REJECT,pre-matching
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,xiaohongshu.com)),REJECT-NO-DROP

[URL Rewrite]
^https?:\/\/ci\.xiaohongshu\.com\/system_config\/watermark - reject-img
^https?:\/\/edith\.xiaohongshu\.com\/api\/ads\/material\/guide(?:\?|$) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/marketing\/box\/trigger(?:\?|$) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/marketing\/box_trigger\/goods_search - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/marketing\/execution_strategy\/ - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/marketing\/get_fixed_banner_of_benefits_claim(?:\?|$) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/user_banner(?:\?|$) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/detailfeed\/preload(?:\?|$) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/surprisebox\/(?:get_style|open|submit_action) - reject-dict
^https?:\/\/edith\.xiaohongshu\.com\/api\/usergrowth\/mallbanner(?:\?|$) - reject-dict
^https?:\/\/mediacloud\.xiaohongshu\.com\/api\/httpdns\/ - reject
^https?:\/\/referee\.xiaohongshu\.com\/v\d+\/third\/collect(?:\?|$) - reject
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/ads\/apple\/record(?:\?|$) - reject

[Body Rewrite]
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed(?:\?|$) 'if type=="object" and (.data|type)=="array" then .data |= map(select((.|type)!="object" or (((.note_attributes? // []) | index("goods")) == null))) else . end'
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed(?:\?|$) 'if type=="object" and (.data|type)=="array" then .data |= map(select((.|type)!="object" or ((has("ads_info")|not) and ((.is_ads? // false) != true)))) else . end'
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/imagefeed(?:\?|$) 'if type=="object" and (.data|type)=="array" and (.data[0]|type)=="object" and (.data[0].note_list|type)=="array" then .data[0].note_list |= map((if (.media_save_config|type)=="object" then .media_save_config |= (.disable_save=false | .disable_watermark=true | .disable_weibo_cover=true) else . end) | (if (.function_switch|type)=="array" then .function_switch |= map(if (.|type)=="object" and .type? == "image_download" then .enable=true else . end) else . end) | (if (.hash_tag|type)=="array" then .hash_tag |= map(select((.|type)!="object" or .type? != "interact_vote")) else . end) | (if (.share_info|type)=="object" and (.share_info.function_entries|type)=="array" and (.share_info.function_entries|length)>0 and (.share_info.function_entries[0].type? != "video_download") then .share_info.function_entries = [{"type":"video_download"}, .share_info.function_entries[]] else . end) | (if (.note_text_press_options|type)=="array" and ([.note_text_press_options[] | select((.|type)=="object" and .key? == "copy")]|length)==0 then .note_text_press_options = [.note_text_press_options[], {"key":"copy","extra":""}] else . end)) else . end'
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/video\/save(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data|has("disable")) then .data |= (delpaths([["disable"],["msg"]]) | setpath(["status"]; 2)) else . end'
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/videofeed(?:\?|$) 'if type=="object" and (.data|type)=="array" then .data |= map((if (.media_save_config|type)=="object" then .media_save_config |= (.disable_save=false | .disable_watermark=true | .disable_weibo_cover=true) else . end) | (if (.function_switch|type)=="array" then .function_switch |= map(if (.|type)=="object" and .type? == "video_download" then (.enable=true | del(.reason)) else . end) else . end) | (if (.share_info|type)=="object" and (.share_info.function_entries|type)=="array" and ([.share_info.function_entries[] | select((.|type)=="object" and .type? == "video_download")]|length)==0 then .share_info.function_entries = [.share_info.function_entries[], {"type":"video_download"}] else . end)) else . end'
http-response-jq ^https?:\/\/(?:edith|rec|www)\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/videofeed(?:\?|$) 'if type=="object" and (.data|type)=="array" then .data |= map(select((.|type)!="object" or (.source_note? == true) or (((.note_attributes? // []) | index("goods")) == null))) else . end'
http-response-jq ^https?:\/\/(?:so|edith)\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.items|type)=="array" then .data.items |= map(select((.|type)=="object" and .model_type? == "note")) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/im\/v\d+\/get_banner_list(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","banner_info_list"]; []) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/ads\/resource(?:\?|$) 'if type=="object" and (.data|type)=="array" then setpath(["data"]; []) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/content\/video\/get_ads_info(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data"]; {}) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/comment\/list(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.comments|type)=="array" then .data.comments |= map((if .comment_type? == 3 then .comment_type=2 else . end) | (if .media_source_type? == 1 then .media_source_type=0 else . end) | (if (.sub_comments|type)=="array" then .sub_comments |= map((if .comment_type? == 3 then .comment_type=2 else . end) | (if .media_source_type? == 1 then .media_source_type=0 else . end)) else . end)) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.widget_list|type)=="array" then .data.widget_list |= map(select((.|type)!="object" or (((.biz_type? // "") | test("(goods|buyable|packed|product|brand|ads_|pgy_|cooperate_)"))|not))) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.widget_list|type)=="array" then .data.widget_list |= map(select((.|type)!="object" or (((.track.name? // "") | test("(GOODS|BUYABLE|PACKED|PRODUCT|BRAND|ADS_|PGY_|COOPERATE_|ACTIVITY_COMPONENT)"))|not))) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets(?:\?|$) 'if type=="object" and (.data|type)=="object" then delpaths([["data","generic"],["data","goods_comment_section_card"]]) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/recommend\/user\/follow_recommend(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.rec_users|type)=="array" and (.data.rec_users|length)>0 then setpath(["data"]; {}) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.data|type)=="object" then setpath(["data","data","hint_word"]; {}) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.data|type)=="object" then setpath(["data","data","queries"]; []) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending(?:\?|$) 'if type=="object" and (.data|type)=="object" then delpaths([["data","card_entry"]]) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config(?:\?|$) 'if type=="object" and (.data|type)=="object" then delpaths([["data","loading_img"],["data","splash"],["data","store"]]) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","ads_groups"]; []) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","bidding_ads"]; []) else . end'
http-response-jq ^https?:\/\/live-go\.xiaohongshu\.com\/api\/sns\/red\/live\/app\/v\d+\/ecology\/inform_card\/active_card(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","inform_cards"]; []) else . end'
http-response-jq ^https?:\/\/live-mall\.xiaohongshu\.com\/api\/sns\/red\/livemall\/app\/marketing\/get_config(?:\?|$) 'if type=="object" and (.data|type)=="object" then delpaths([["data","coupon_config"],["data","flash_buy"]]) else . end'
http-response-jq ^https?:\/\/live-room\.xiaohongshu\.com\/api\/sns\/red\/live\/rank\/entrance\/list(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","entrances"]; []) else . end'
http-response-jq ^https?:\/\/live-room\.xiaohongshu\.com\/api\/sns\/v\d+\/live\/feed\/waterfall(?:\?|$) 'if type=="object" and (.data|type)=="object" and (.data.feeds|type)=="array" then .data.feeds |= map(select((.|type)!="object" or (((.ads_live? // false) != true) and ((.ads_info? // "{}") == "{}")))) else . end'
http-response-jq ^https?:\/\/search\.xiaohongshu\.com\/api\/search\/fls\/placeholder(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","placeholder"]; []) else . end'
http-response-jq ^https?:\/\/so\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/recommend(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data","items"]; []) else . end'
http-response-jq ^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/tag\/ads_engage(?:\?|$) 'if type=="object" and (.data|type)=="object" then delpaths([["data","default_img_list"]]) else . end'
http-response-jq ^https?:\/\/www\.xiaohongshu\.com\/api\/store\/jpd\/edith\/native\/payment_marketing(?:\?|$) 'if type=="object" and (.data|type)=="object" then setpath(["data"]; {}) else . end'

[MITM]
hostname = %APPEND% ci.xiaohongshu.com,edith.xiaohongshu.com,live-go.xiaohongshu.com,live-mall.xiaohongshu.com,live-room.xiaohongshu.com,mediacloud.xiaohongshu.com,rec.xiaohongshu.com,referee.xiaohongshu.com,search.xiaohongshu.com,so.xiaohongshu.com,www.xiaohongshu.com
