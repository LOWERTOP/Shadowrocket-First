#!name=🆁🆄🅸🆇🅸🅽🅶 瑞幸咖啡
#!desc=屏蔽瑞幸咖啡开屏广告及部分其他广告。本模块仅为自用，不保证可以将广告或弹窗全部清理
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/lkcoffee.png
#!arguments=
#!arguments-desc=
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[URL Rewrite]
# 屏蔽开屏广告
^https:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew(?:\?.*)?$ - reject
# 屏蔽部分弹窗
^https:\/\/(ec|c)api\.lkcoffee\.com\/resource\/m\/eorder\/product\/popAppTagProductList(?:\?.*)?$ - reject

[Map Local]
# 屏蔽广告图片
^https?:\/\/img0[1-9]\.luckincoffeecdn\.com\/group\d\/M00\/[A-Z0-9]{2}\/[A-Z0-9]{2}\/[a-zA-Z0-9]{29}\.(jpg|jpeg)_\.webp$ data-type=text data=" "

[MITM]
hostname = %APPEND% capi.lkcoffee.com, ecapi.lkcoffee.com, img0*.luckincoffeecdn.com
