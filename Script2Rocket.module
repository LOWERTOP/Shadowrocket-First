#!name=🅿🅻🆄🅶🅺🅸🆃 插件中心转换器
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/img/Shadowrocket_icon.png
#!desc=将可莉插件中心转换给小火箭使用; 插件中心 https://pluginhub.kelee.one; 此版集成Script-Hub，若有侵权可联系我们立马删除
#!arguments=Script-Hub:true, 原版转换脚本:false, 兼容转换脚本:true, Plugin-Hub:http
#!arguments-desc=🔘Script-Hub\n\n· 默认启用，若禁用则下方设置无效\n\n🔘 Plugin-Hub\n\n· 可莉插件中心变身，默认启用，填入 # 可禁用\n\n🔘 原版转换脚本\n\n· 不兼容 Loon 新语法，默认禁用\n\n🔘 兼容转换脚本\n\n· 可兼容 Loon 新语法，默认启用，需要禁用原版脚本
#!author=iab0x00，LOWERTOP，感谢资源作者@iKeLee(https://github.com/luestr) 和 Script-Hub(https://github.com/Script-Hub-Org)作者(@小白脸 @xream @keywos @ckyb)
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[General]
force-http-engine-hosts = %APPEND% script.hub, *.script.hub

[Body Rewrite]
{{{Plugin-Hub}}}-response ^https://hub\.kelee\.one/list\.json "loon://import\?plugin=(https://kelee.one/Tool/Loon/Lpx/(.+).lpx)" "shadowrocket://install?module=http://script.hub/file/_start_/$1/_end_/$2.sgmodule%3Ftype%3Dloon-plugin%26target%3Dshadowrocket-module%26del%3Dtrue%26jqEnabled%3Dtrue"

[Header Rewrite]
{{{Plugin-Hub}}}-request ^https://hub\.kelee\.one/list\.json header-del if-none-match

[Script]
# Script Hub
Script Hub: 前端 = type=http-request, pattern=^https?:\/\/script\.hub\/($|edit\/|reload), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js, timeout=300, enable={{{Script-Hub}}}
# 原版转换脚本
Script Hub: 重写转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300, enable={{{原版转换脚本}}}

# 兼容转换脚本，借用 jasonperter 版本
Script Hub: 重写转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/jasonperter/Script-Hub/main/Rewrite-Parser.js, timeout=300, enable={{{兼容转换脚本}}}

# Script Hub
Script Hub: 规则集转换 = type=http-request, pattern=^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.js, timeout=300, enable={{{Script-Hub}}}
Script Hub: 脚本转换 = type=http-request, pattern=^https?:\/\/script\.hub\/convert\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js, timeout=300, enable={{{Script-Hub}}}

[MITM]
hostname = %APPEND% script.hub, *.script.hub, hub.kelee.one, pluginhub.kelee.one
