#!name=🅳🅸🆂🅲🅾🆁🅳 Discord 翻译
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/refs/heads/main/img/Discord.png
#!desc=调用 Google 翻译为 Discord 历史消息生成双语对照，静默追加译文；支持浏览历史消息及上滑加载，新消息由于走 WebSocket 实时流式长连接，需通过重新进入频道触发刷新
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discord.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discordapp.com)),REJECT

[Script]
Discord-Local-Translate = type=http-response,pattern=^https://(discord|discordapp).com/api/v\d+/channels/\d+/messages,requires-body=1,max-size=524288,timeout=10,script-path=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/JS/discord_translate.js

[MITM]
hostname = %APPEND% discord.com, discordapp.com
