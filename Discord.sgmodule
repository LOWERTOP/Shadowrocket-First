#!name=🅳🅸🆂🅲🅾🆁🅳 Discord 翻译
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/refs/heads/main/img/Discord.png
#!desc=调用 Google 翻译为 Discord 历史消息生成双语对照，静默追加译文；支持自定义翻译条目数量与目标语言
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First
#!arguments=翻译条目数量:50, 翻译目标语言:zh-CN
#!arguments-desc=翻译条目数量：单次请求最多翻译的消息条数，默认 50。\n\n翻译目标语言：指定译文语言，填写 Google 翻译支持的语言代码，默认 zh-CN（简体中文）。例如 zh-TW（台湾繁体）、zh-HK（香港繁体）、ja（日语）、ko（韩语）

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discord.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,discordapp.com)),REJECT

[Script]
Discord-Local-Translate = type=http-response,pattern=^https://(discord|discordapp).com/api/v\d+/channels/\d+/messages,requires-body=1,max-size=524288,timeout=10,script-path=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/JS/discord_translate.js,argument={{{翻译条目数量}}}|{{{翻译目标语言}}}

[MITM]
hostname = %APPEND% discord.com, discordapp.com
