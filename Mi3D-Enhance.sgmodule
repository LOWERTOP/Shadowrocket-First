#!name=🆁🅴🆂🅸🅽🅿🆁 米家3D打印增强
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/img/mi3d.png
#!desc=编辑参数以隐藏底部标签页
#!arguments=隐藏首页:true, 隐藏社区:true, 隐藏创意:true, 隐藏消息:true, 隐藏我的:false
#!arguments-desc=切换开关状态并重启软件即可生效
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[Body Rewrite]
http-response-jq ^https?:\/\/app\.mieco\.net\/api\/utrend-printing\/buttonConfig\/1(?:\?.*)?$ 'if (.data | type) == "array" then .data |= map(select((.name != "首页" or {{{隐藏首页}}} != true) and (.name != "社区" or {{{隐藏社区}}} != true) and (.name != "创意" or {{{隐藏创意}}} != true) and (.name != "消息" or {{{隐藏消息}}} != true) and (.name != "我的" or {{{隐藏我的}}} != true))) else . end'

[MITM]
hostname = %APPEND% app.mieco.net
