#!name=🅶🅸🆃🅷🆄🅱 限制解除
#!desc=解除 GitHub 针对 zh-CN 的语言限制
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/github_00.png
#!author=@iab0x00
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[Script]
GitHub = type=http-request, script-path=https://lowertop.github.io/Shadowrocket-First/JS/github-header.js, pattern=^https:\/\/[a-z0-9-]+\.githubusercontent\.com, max-size=0, timeout=30, script-update-interval=0, enable=true

[MITM]
hostname = %APPEND% *.githubusercontent.com
