#!name=🆃🅾🅿🅼🅾🅳🆂 优化VPN检测提示
#!desc=通过调整部分域名的处理方式，改善部分应用在非 TUN 模式下出现“检测到正在使用 VPN”等提示的问题。规则来源：github.com/mieqq
#!arguments=补充跳过代理接口的域名:#英文逗号分隔域名, 补充总是真实IP的域名:#英文逗号分隔域名
#!arguments-desc=注释：\n\n跳过代理：此选项强制这些地址的连接范围由 TUN 接口来处理，而不是其他接口\n\n总是真实 IP：此选项要求在 TUN 处理 DNS 请求时返回一个真实的 IP 地址而不是假的 IP 地址\n\n更多详情请查看：https://github.com/mieqq/mieqq/blob/master/skip-proxy-lists.sgmodule
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/img/Shadowrocket_icon.png
#!homepage=https://github.com/mieqq/mieqq/blob/master/skip-proxy-lists.sgmodule

[General]
# 跳过代理。此选项强制这些域名或 IP 的连接范围由 Shadowrocket TUN 接口来处理，而不是 Shadowrocket 代理服务器。此选项用于解决一些应用程序的一些兼容性问题。
skip-proxy = gate.lagou.com, id6.me, login-service.mobile-bank.psbc.com, mobile-bank.psbc.com, www.abchina.com.cn, www.baidu.com, www.shanbay.com, wxh.wo.cn, yunbusiness.ccb.com, {{{补充跳过代理接口的域名}}}

# 总是真实 IP。此选项要求 Shadowrocket 在 TUN 处理 DNS 请求时返回一个真实的 IP 地址而不是假的 IP 地址。
always-real-ip = *-update.xoyocdn.com, easy-login.10099.com.cn, id6.me, open.e.189.cn, {{{补充总是真实IP的域名}}}

[Rule]
# 农行VPN检测
DOMAIN,msmp.abchina.com.cn,REJECT
