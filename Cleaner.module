#!name=🅲🅻🅴🅰🅽🅴🆁
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/AdblockPlus.png
#!desc=红果短剧、包子漫画网页、小蚁摄像机、德施曼、Pinterest 等去广告。模块仅为自用，不承诺完全去除相应服务的广告
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First

[Rule]
# 放行抖音商城图片地址
DOMAIN,p3-ad-sign.byteimg.com,DIRECT
# 红果短剧部分去广告规则
DOMAIN-WILDCARD,*-misc-lq.fqnovel.com,REJECT
DOMAIN-WILDCARD,*-reading-ad.qznovelvod.com,REJECT
DOMAIN-WILDCARD,*-ad-sign.byteimg.com,REJECT
DOMAIN-WILDCARD,*-iosreadingvideo.qznovelvod.com,REJECT
DOMAIN-WILDCARD,ads*-normal-l*.zijieapi.com,REJECT
DOMAIN-SUFFIX,v11-reading-video.qznovelvod.com,REJECT

# 德施曼
# 多盟（Domob）广告网络：拦截广告图片、静态资源及路由
DOMAIN-SUFFIX,domop.com,REJECT
# 第三方广告展示与点击归因跟踪
DOMAIN-SUFFIX,ad-dr.com,REJECT
# Talk-Plus 商业广告 SDK 接口
DOMAIN,sdk-open-ad.talk-plus.com,REJECT
# VarTrack 用户行为日志与跟踪上报
DOMAIN-SUFFIX,vartrack.com,REJECT
# 应用冷启动与性能日志打点
DOMAIN,loadstart.logg.aerogx.com,REJECT
# 阿里开放追踪 SDK（仅拦截数据统计，不影响支付）
DOMAIN,sdk.open-track.alipay.com,REJECT
# Shopee 客户端打点与登录追踪（不影响购物主体功能）
DOMAIN,m-stat.m.shopee.tw,REJECT
DOMAIN,shopee-tracker-sign-in.shopeemobile.com,REJECT
# 友盟+（数据派）行为统计与数据埋点
DOMAIN-SUFFIX,shujupie.com,REJECT
# 统计与点击归因平台
DOMAIN-SUFFIX,statisticslinks.com,REJECT
# 动态广告与第三方配置接口（若导致特定 App 内容加载失败可禁用）
DOMAIN,yumao.puata.info,REJECT
# 个推（GeTui）设备分析与画像上报
DOMAIN-SUFFIX,gepush.com,REJECT
DOMAIN-SUFFIX,getui.com,REJECT
DOMAIN-SUFFIX,getui.net,REJECT

# 包子漫画所需特定规则
# DOMAIN-SUFFIX,baozimhcn.com,DIRECT
# DOMAIN-SUFFIX,baozimh.com,DIRECT
# DOMAIN-SUFFIX,baozicdn.com,DIRECT
# DOMAIN-SUFFIX,dzmanga.com,DIRECT
# DOMAIN-SUFFIX,twmanga.com,DIRECT
# DOMAIN-SUFFIX,baozimhapp.com,REJECT
# === 搜索引擎与网站分析 ===
# DOMAIN-SUFFIX,google-analytics.com,REJECT
# DOMAIN-SUFFIX,statcounter.com,REJECT
# DOMAIN-SUFFIX,clarity.ms,REJECT
# DOMAIN-SUFFIX,bitloader.net,REJECT
# === 内容推荐与原生广告 ===
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,outbrainimg.com,REJECT
# === 程序化广告与竞价平台 (DSP/SSP/RTB) ===
# DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,pubmatic.com,REJECT
DOMAIN-SUFFIX,openx.net,REJECT
DOMAIN-SUFFIX,bidswitch.net,REJECT
DOMAIN-SUFFIX,casalemedia.com,REJECT
DOMAIN-SUFFIX,adnx.com,REJECT
DOMAIN-SUFFIX,media.net,REJECT
DOMAIN-SUFFIX,adform.net,REJECT
DOMAIN-SUFFIX,seedtag.com,REJECT
DOMAIN-SUFFIX,tremorhub.com,REJECT
DOMAIN-SUFFIX,monetixads.com,REJECT
DOMAIN-SUFFIX,nexx360.io,REJECT
DOMAIN-SUFFIX,servenobid.com,REJECT
DOMAIN-SUFFIX,cootlogix.com,REJECT
DOMAIN-SUFFIX,kueezrtb.com,REJECT
DOMAIN-SUFFIX,adrubi.com,REJECT
DOMAIN-SUFFIX,adtarget.biz,REJECT
DOMAIN-SUFFIX,omni-dex.io,REJECT
DOMAIN-SUFFIX,4dex.io,REJECT
DOMAIN-SUFFIX,rfihub.com,REJECT
DOMAIN-SUFFIX,rfihub.net,REJECT
# === 数据追踪与受众分析 ===
DOMAIN-SUFFIX,scorecardresearch.com,REJECT
DOMAIN-SUFFIX,eyeota.net,REJECT
DOMAIN-SUFFIX,demdex.net,REJECT
DOMAIN-SUFFIX,imrworldwide.com,REJECT
DOMAIN-SUFFIX,liadm.com,REJECT
DOMAIN-SUFFIX,everesttech.net,REJECT
DOMAIN-SUFFIX,rezync.com,REJECT
# === 其他未知或高频追踪分发域名 ===
DOMAIN-SUFFIX,holmesmind.com,REJECT
DOMAIN-SUFFIX,rbstsystems.live,REJECT
DOMAIN-SUFFIX,rtmark.net,REJECT
DOMAIN-SUFFIX,sootoarathus.net,REJECT
DOMAIN-SUFFIX,chagnougoalry.net,REJECT
DOMAIN-SUFFIX,brilliantchap.com,REJECT
DOMAIN-SUFFIX,aqle3.com,REJECT

[URL Rewrite]
# 包子漫画横幅APP广告
^https?:\/\/static-tw\.baozimh\.com\/bzmhapp-data\/pics\/install_app_bar_baozimhappx\.jpg$ - REJECT

# 小蚁
^https?://api.xiaoyi.com\/v5\/app\/mobile\/ads - REJECT
^https?://api.xiaoyi.com\/v5\/app\/config\?userid=.* - REJECT

[Body Rewrite]
# Pinterest
http-response-jq ^https:\/\/api\.pinterest\.com\/v\d\/feeds\/home\/\? '.data |= map(select(.is_promoted == false or .is_promoted == "false"))'
http-response-jq ^https:\/\/api\.pinterest\.com\/v\d\/pins\/\d+\/related\/modules\/\? '.data |= map(select(.is_promoted == false or .is_promoted == "false"))'

[Script]
# 包子漫画网页
web-element-block = type=http-response,pattern=^https?:\/\/([a-zA-Z0-9-]+\.)*(baozimhcn|dzmanga)\.com\/.*,requires-body=1,script-path=https://lowertop.github.io/Shadowrocket-First/JS/baozimh.js

[MITM]
hostname = %APPEND% static-tw.baozimh.com, *.baozimhcn.com, *.dzmanga.com, *.xiaoyi.com, api.pinterest.com
