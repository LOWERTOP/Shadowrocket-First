#!name=🆀🅸🅽🅶🅰🅿🅿 Qing 净化增强
#!icon=https://raw.githubusercontent.com/LOWERTOP/Shadowrocket-First/main/img/Qing.png
#!desc=移除开屏广告、阻断火山引擎与 MobTech 隐私追踪、禁用 HTTPDNS；可在编辑参数页面启用本地解锁真实视界、隐身消息配额满载、动态媒体下载解锁、强制透视附近的人隐身活跃状态及实验性测试增加地图位置切换限制次数
#!arguments=功能解锁:false,活跃时间:false,允许下载:false,隐身配额:false,更新弹窗:false,地图次数:false
#!arguments-desc=🔘 功能解锁: 显示 VIP 标识、真实视界、最高资料可见度与超长视频限制 \n🔘 活跃时间: 强制透视附近的人隐藏的最后活跃时间 \n🔘 允许下载: 解锁动态图片与视频保存下载权限 \n🔘 隐身配额: 隐身消息发送配额修改为 999 \n🔘 更新弹窗: 屏蔽版本更新提示弹窗 \n🔘 地图次数: 实验性测试提高每日地图位置切换次数，固定值为 20
#!author=LOWERTOP
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First
[Rule]
# 阻断火山引擎 APMPlus 与 Gator 遥测埋点
DOMAIN-SUFFIX,apmplus.volces.com,REJECT
DOMAIN-SUFFIX,gator.volces.com,REJECT
# 阻断掌淘科技日志收集、分享统计与应用列表探测 (保留 sdk.push.mob.com 推送服务)
DOMAIN,api.share.mob.com,REJECT
DOMAIN,cfgc.zztfly.com,REJECT
DOMAIN,upc.zztfly.com,REJECT
DOMAIN,fdl.zztfly.com,REJECT
DOMAIN,errc.zztfly.com,REJECT
DOMAIN,devc.zztfly.com,REJECT
DOMAIN,log-auth.zztfly.com,REJECT
DOMAIN,api-auth.zztfly.com,REJECT
DOMAIN,cdn-api-auth.zztfly.com,REJECT
DOMAIN-SUFFIX,flysleep.cn,REJECT
# 阻断阿里云 HTTPDNS (强制回退系统 DNS，防止 IP 直连绕过 MITM)
DOMAIN,metric-service.httpdns.aliyuncs.com,REJECT
IP-CIDR,203.107.1.0/24,REJECT,no-resolve
IP-CIDR,203.119.204.226/32,REJECT,no-resolve
IP-CIDR,203.119.238.194/32,REJECT,no-resolve
IP-CIDR6,2401:b180:2000::/36,REJECT,no-resolve
IP-CIDR6,2401:b180:7001::/48,REJECT,no-resolve
[URL Rewrite]
# 阻断开屏广告曝光统计上报
^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/app\/splash\/exposures - reject-dict
# 阻断 DoH 动态域名解析与 HTTPDNS 接口请求
^https?:\/\/223\.5\.5\.5\/resolve\?name=qingapp\.bilifans\.com - reject-200
^https?:\/\/[^\/]+\/(116314\/ss|v2\/d\?id=116314) - reject-200
# 阻断火山引擎与 MobTech 统计接口
^https?:\/\/apmplus\.volces\.com\/(apm|monitor)\/ - reject-dict
^https?:\/\/gator\.volces\.com\/service\/2\/(app_log|abtest_config|log_settings|device_register|app_alert_check) - reject-dict
^https?:\/\/(cfgc|upc|fdl|errc|devc)\.(zztfly\.com|flysleep\.cn)\/(v\d\/gcf|v\d\/gcl|suba\/list|dm|privacy\/) - reject-dict
^https?:\/\/api\.share\.mob\.com\/(conn|conf5|snsconf) - reject-dict
[Body Rewrite]
# 清空开屏广告、关闭内置 HTTPDNS、提升资料可见等级为 4
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/users\/app\/config '.data.splash_config = [] | .data.http_dns_disabled = true | .data.hide_in_review_features = false | if ({{{功能解锁}}} == true) then (.data.user_profile_visible_level = 4) else . end'
# 屏蔽版本更新弹窗
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/app\/config\/version-update 'if ({{{更新弹窗}}} == true) then (.data.update = false | .data.is_latest_version = true | .data.mode = "" | .data.title = "" | .data.message = "" | .data.update_url = "") else . end'
# 本地解锁 VIP、解除敏感期修改锁定、清空隐藏字段限制、提升视频时长上限
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/users\/profile\/(details|basic) 'if ({{{功能解锁}}} == true) then (.data.is_vip = true | .data.sensitive_date_blocked = false | if (.data | has("hidden_fields")) then .data.hidden_fields = [] else . end | if .data.user_usage_config then (.data.user_usage_config.max_chat_video_duration = 3600 | .data.user_usage_config.max_moments_video_duration = 3600 | .data.user_usage_config.max_moments_video_cover_duration = 180) else . end) else . end'
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/users\/login\/auto 'if ({{{功能解锁}}} == true) then (.data.user_profile_visible_level = 4 | .data.requires_invite_code = false) else . end'
# 解锁访客“真实视界”
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/me\/default_page_info 'if ({{{功能解锁}}} == true) then (.data.true_sight = true) else . end'
# 隐身消息发送配额增强
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/users\/chat\/invisible_msg\/quota 'if ({{{隐身配额}}} == true) then (.data.max_count = 999 | .data.remain_count = 999) else . end'
# 实验性修改地图每日位置切换限制 (HAR 中仅确认 daily_switch_location_limit 字段)
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/vibes\/nearby\/config 'if ({{{地图次数}}} == true and (.data | type == "object") and (.data | has("daily_switch_location_limit"))) then (.data.daily_switch_location_limit = 20) else . end'
# 恢复附近的人列表中被隐藏的活跃时间
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/vibes\/nearby\/list 'if ({{{活跃时间}}} == true and (.data.list | type == "array")) then (.data.list |= map(if (.user_last_active_at == 0 and .last_active_at > 0) then (.user_last_active_at = .last_active_at | .user_last_active_at_str = "👁️隐身活跃") else . end)) else . end'
# 动态流媒体下载权限解锁
http-response-jq ^https?:\/\/api\.qing2000\.(com|net|cc|cn)\/api\/feeds\/moments\/ 'if ({{{允许下载}}} == true) then walk(if type == "object" and has("allow_download_medias") then .allow_download_medias = true else . end) else . end'
[MITM]
hostname = %APPEND% api.qing2000.com, api.qing2000.net, api.qing2000.cc, api.qing2000.cn, 223.5.5.5
